Port 2222
ListenAddress 0.0.0.0
HostKey /var/lib/aas/ssh/ssh_host_ed25519_key
PidFile /run/sshd.pid
AuthorizedKeysFile /run/aas/%u/authorized_keys
AllowUsers dsh-a dsh-b
PermitRootLogin no
StrictModes yes
PubkeyAuthentication yes
AuthenticationMethods publickey
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
UsePAM no
PermitTTY no
PermitUserRC no
PermitUserEnvironment no
X11Forwarding no
AllowAgentForwarding no
AllowStreamLocalForwarding no
AllowTcpForwarding remote
GatewayPorts no
PermitTunnel no
PermitListen none
PrintMotd no
PrintLastLog no

Match User dsh-a
    PermitListen 127.0.0.1:43101
    ForceCommand /usr/local/bin/aas ingress /run/aas/dsh-a/ingress.json

Match User dsh-b
    PermitListen 127.0.0.1:43102
    ForceCommand /usr/local/bin/aas ingress /run/aas/dsh-b/ingress.json
